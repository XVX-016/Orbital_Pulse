# Orbital Pulse Environment Variables
# Copy this file to .env and fill in your values before running locally or via Docker.

# REQUIRED — 3D globe will not render without this token.
# Obtain a free token at: https://ion.cesium.com/tokens
# Used by Vite at build time (local dev) AND as a Docker build arg (docker compose up --build).
VITE_CESIUM_ION_TOKEN=

# Service endpoints — these defaults work for both local dev and Docker (localhost-based)
VITE_ORBIT_SERVICE_URL=http://localhost:8081
VITE_AI_SERVICE_URL=http://localhost:8082

# PostGIS credentials (used by docker-compose only)
POSTGRES_USER=orbital_user
POSTGRES_PASSWORD=orbital_password
POSTGRES_DB=orbital_db

# Track B severe-weather monitoring — MOSDAC (SAC-ISRO) account for INSAT-3DR data.
# Register at https://www.mosdac.gov.in/ . Three wrong passwords in a row lock the
# account for 1 hour; the service stops retrying after the first rejection.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
INSAT_DATASET_ID=3RIMG_L1C_ASIA_MER
